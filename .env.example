# ============================================================================
#  Fin Advisor - settings template
#  Copy this file to .env and fill in your values. .env is git-ignored;
#  this template has no secrets and is safe to commit.
#  After any change to .env, restart the server (npm start).
#  Format: NAME=value, no spaces around "=", no quotes, no comment after a value.
# ============================================================================


# ---------------------------------------------------------------------------
#  1. AI research & planning assistant (free)
# ---------------------------------------------------------------------------
# Paste ONE free key. The provider is detected from how the key starts:
#
#   Groq           gsk_...    https://console.groq.com/keys
#   Google Gemini  AIza...    https://aistudio.google.com/apikey
#   OpenRouter     sk-or-...  https://openrouter.ai/keys
#
# Required for the Research screen: every question is answered by the AI agent.
FREE_AI_API_KEY=

# Optional: change the model if the provider retires the default one.
#   Groq default:        openai/gpt-oss-120b
#   Gemini default:      gemini-2.5-flash
#   OpenRouter default:  meta-llama/llama-3.3-70b-instruct:free
# FREE_AI_MODEL=

# Optional: models to switch to when the main one hits the free per-minute limit,
# comma-separated. Groq default: openai/gpt-oss-20b
# FREE_AI_FALLBACK_MODELS=

# Optional: only for a key that does not start with one of the prefixes above.
# FREE_AI_PROVIDER can be groq, gemini or openrouter. For any other
# OpenAI-compatible service, set FREE_AI_BASE_URL and FREE_AI_MODEL instead.
# FREE_AI_PROVIDER=
# FREE_AI_BASE_URL=


# ---------------------------------------------------------------------------
#  2. Claude (optional, paid)
# ---------------------------------------------------------------------------
# If set, Claude is used instead of the free provider.
ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------------
#  3. Email for "Forgot password?" (optional)
# ---------------------------------------------------------------------------
# Reset links are emailed through any SMTP account. Without these settings the
# link is printed in the server window instead (fine for local use).
#
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465   SMTP_USER=you@gmail.com
# Outlook / Microsoft 365:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to the adviser. Default: Fin Advisor <SMTP_USER>
# MAIL_FROM=Fin Advisor <you@gmail.com>

# Address of this website, used in reset links. Set it if the site is not
# opened at http://localhost:<PORT>, e.g. https://advisor.example.com
# APP_URL=


# ---------------------------------------------------------------------------
#  4. Server
# ---------------------------------------------------------------------------
# Port for http://localhost:<PORT>
PORT=4400

# SQLite database file. Default: data/copilot.db
# DB_PATH=data/copilot.db
